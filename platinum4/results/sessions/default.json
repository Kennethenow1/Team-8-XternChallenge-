      ],
      "topics": [
        "restudy",
        "delay_of_study",
        "withdrawal",
        "cost_allocation",
        "gia_negotiation"
      ],
      "excerpt": "The Interconnection Customer (IC) may be responsible for funding the restudy and any resulting upgrades, as determined by MISO (the Transmission Provider) (BPM-015 r33 §5.4.6). The IC must notify MISO within five (5) Business Days whether it wishes to proceed with the Interconnection Study restudy or withdraw its interconnection request (IR) (BPM-015 r33 §5.4.6). ## Citations - BPM-015 r33 §5.4.6 - Interconnection Study Restudy (pages 56-56) ## Must not claim - do not quote m",
      "need_search": false
    }
